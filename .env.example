# Supabase — copy this file to .env.local and fill in your project's values.
# Find them in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin account email (must exist in Supabase Authentication → Users)
ADMIN_EMAIL=careerofexcellence.learn@gmail.com

# Public URL of the deployed site — set this after connecting the domain on
# Vercel (used for SEO: canonical links, sitemap, Open Graph tags)
NEXT_PUBLIC_SITE_URL=https://www.elevaacademy.in